# ============================================================
#  敏感与运行时产物 —— 严禁提交（含个人隐私 / 会话凭证 / 大文件）
# ============================================================

# 会话 token 缓存与运行状态（含 au / 学号 / 姓名 / sessionKey）
au_token_cache.json
*_state.json
run_once_state.json

# 运行日志（真实日志含 PII，仅提交 samples/ 下的脱敏示例）
*.log
!samples/*.log

# 进程内存转储与内存扫描结果（极大且含明文凭证）
*.dmp
*.dump
mem_*scan*.txt
mem_au_scan_latest.txt

# 反编译 / 解包出的小程序源码（第三方知识产权，不再分发）
unpacked/
modules/
dumps/
dumps2/
*.wxapkg

# 上传用的临时图片等运行时目录
runtime/

# Python / 编辑器杂项
__pycache__/
*.pyc
.venv/
.idea/
.vscode/
.DS_Store
